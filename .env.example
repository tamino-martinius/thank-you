# Copy to `.env` and fill in. `.env` is gitignored and is copied into every
# Conductor workspace automatically (see .worktreeinclude).
#
# Only the data pipeline (`npm run collect` / `npm run sync`) reads this.
# `npm run serve` renders the committed graph and needs nothing here.

# Optional: a classic GitHub PAT (no scope needed for public data) for a
# 5000/hr rate limit. If blank, falls back to GH_TOKEN / GITHUB_TOKEN / `gh auth`.
GH_PAT=
